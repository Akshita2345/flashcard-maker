<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/theme.css" />
  <title>Add Deck</title>
</head>
<body>
  <header class="top">
    <a class="logo" href="/dashboard">Flashcard</a>
    <div class="nav">
      <a href="/dashboard">Dashboard</a>
      <button id="themeToggle">Theme</button>
    </div>
  </header>
  <main class="wrap">
    <h1>Add deck</h1>
    <% if (error) { %><div class="error"><%= error %></div><% } %>
    <% if (step === 'init') { %>
      <form method="post" action="/deck/create-init" class="form">
        <label>Deck name</label>
        <input name="name" required />
        <label>Number of cards</label>
        <input type="number" min="1" name="count" required />
        <button type="submit">Create</button>
      </form>
    <% } %>
    <% if (step === 'cards') { %>
      <form method="post" action="/deck/<%= deck.id %>/cards/save" class="form">
        <input type="hidden" name="deckId" value="<%= deck.id %>" />
        <% for (let i = 0; i < count; i++) { %>
          <div class="row">
            <input name="questions" placeholder="Question <%= i+1 %>" required />
            <input name="answers" placeholder="Answer <%= i+1 %>" required />
          </div>
        <% } %>
        <button type="submit">Save cards</button>
      </form>
    <% } %>
    <% if (step === 'review') { %>
      <section>
        <h2>Saved cards</h2>
        <div class="list">
          <% cards.forEach(c => { %>
            <form class="item" method="post" action="/card/<%= c.id %>/update">
              <input name="question" value="<%= c.question %>" />
              <input name="answer" value="<%= c.answer %>" />
              <button type="submit">Update</button>
            </form>
            <form class="item" method="post" action="/card/<%= c.id %>/delete">
              <button type="submit">Delete</button>
            </form>
          <% }) %>
        </div>
        <form method="post" action="/deck/<%= deck.id %>/finalize">
          <button type="submit">Save deck</button>
        </form>
      </section>
    <% } %>
  </main>
  <script src="/js/theme.js"></script>
</body>
</html>